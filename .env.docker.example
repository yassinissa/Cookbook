# ── Cookbook — self-hosted stack config ──────────────────────────────────────
# cp .env.docker.example .env  →  fill in  →  docker compose up -d --build
# Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public address ──────────────────────────────────────────────────────────
# DNS A record for this must already point at the server. Caddy gets the cert.
COOKBOOK_DOMAIN=cookbook.example.com

# The API URL the browser calls — baked into the frontend bundle at build time.
# With this compose (Caddy routes /api to the backend) it's just <domain>/api.
VITE_API_BASE_URL=https://cookbook.example.com/api

# ── Django ──────────────────────────────────────────────────────────────────
# Use the SAME value that's on Render today. Changing it logs every user out.
SECRET_KEY=

DJANGO_SETTINGS_MODULE=config.settings.production
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=10080

# Hostname(s) only, no scheme, comma-separated. Keep localhost/127.0.0.1 —
# the container's own healthcheck hits the app on localhost, and only Caddy
# can reach it from outside (Caddy forwards the real Host header).
ALLOWED_HOSTS=cookbook.example.com,localhost,127.0.0.1
# WITH scheme, comma-separated.
CORS_ALLOWED_ORIGINS=https://cookbook.example.com
CSRF_TRUSTED_ORIGINS=https://cookbook.example.com

FRONTEND_URL=https://cookbook.example.com
PUBLIC_MENU_BASE_URL=https://cookbook.example.com
PUBLIC_MENU_THROTTLE=60/min

# Caddy terminates TLS and forwards plain HTTP with X-Forwarded-Proto — keep ON.
SECURE_SSL_REDIRECT=True
# Raise to 31536000 + set the two below True once you've confirmed HTTPS is stable.
SECURE_HSTS_SECONDS=3600

# ── Postgres (the `db` service) ─────────────────────────────────────────────
# Any values — they only exist inside the compose network.
DB_NAME=cookbook
DB_USER=cookbook
DB_PASSWORD=change-me-to-a-long-random-string

# ── inventory-platform integration ─────────────────────────────────────────
# If inventory-platform runs on THIS server, use its internal service name and
# skip the public round-trip, e.g.  http://greenhill-api:8000/api
INVENTORY_API_BASE_URL=https://api-inventory.example.com/api
INVENTORY_API_EMAIL=cookbook-service@greenhills.local
INVENTORY_API_PASSWORD=

# ── Email — weekly cost-digest cron ────────────────────────────────────────
# Leave EMAIL_HOST blank and the digest cron will fail loudly (by design).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cookbook <cookbook@greenhills.example>

# ── Optional tuning ────────────────────────────────────────────────────────
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
